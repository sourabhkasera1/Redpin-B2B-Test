            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.RecordType.DeveloperName</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Integrated_B2B</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>T_C_Signed_Date_Set</targetReference>
            </connector>
            <label>Yes - Integrated B2B Opportunity</label>
        </rules>
    </decisions>
    <decisions>
        <description>Evaluates whether the T&amp;C Signed Date field has been set AND Opportunity current Stage is NOT Won, Onboarding &amp; implementation, Engage or Lost</description>
        <name>T_C_Signed_Date_Set</name>
        <label>T&amp;C Signed Date Set &amp; Required Fields Set?</label>
        <locationX>182</locationX>
        <locationY>431</locationY>
        <defaultConnectorLabel>T&amp;C Signed NOT Populated</defaultConnectorLabel>
        <rules>
            <name>T_C_Signed_Date_Populated</name>
            <conditionLogic>1 AND 2 AND 3 AND (4 OR 5 OR 6 OR 7)</conditionLogic>
            <conditions>
                <leftValueReference>$Record.T_C_Signed_Date__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Technical_Scoping_Complete__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Proposal_Sent_Date__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.StageName</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>New</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.StageName</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Contact</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.StageName</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Discovery</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.StageName</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Proposal &amp; Negotiation</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Set_Stage_to_Won</targetReference>
            </connector>
            <label>T&amp;C Signed Date &amp; Req Fields Populated</label>
        </rules>
    </decisions>
