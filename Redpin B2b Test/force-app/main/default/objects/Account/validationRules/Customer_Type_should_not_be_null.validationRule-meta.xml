<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Customer_Type_should_not_be_null</fullName>
    <active>true</active>
    <errorConditionFormula>AND(
     RecordType.DeveloperName != &quot;Integrated_B2B&quot;,
    ISPICKVAL(Customer_Type__c, &quot;&quot;)
)</errorConditionFormula>
    <errorDisplayField>Customer_Type__c</errorDisplayField>
    <errorMessage>Please select Customer Type</errorMessage>
</ValidationRule>
